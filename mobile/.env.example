# Скопируйте в .env.local (он не попадает в Git) и впишите IPv4-адрес ноутбука из ipconfig.
EXPO_PUBLIC_HOST=YOUR_COMPUTER_IP
# Необязательно: полные адреса (если бэкенд/сайт не на портах 8000/5173)
# EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_IP:8000
# EXPO_PUBLIC_WEB_URL=http://YOUR_COMPUTER_IP:5173
